# Cloudflare static-asset headers (prerendered pages + static files).
# SSR'd HTML documents get theirs from src/middleware.ts + Astro (CSP header).
#
# CSP: the Content-Security-Policy line below is a marker - astro.config.ts
# (csp-static-headers) replaces it at build with the policy Astro generates
# (script hashes, no 'unsafe-inline'). Edit the CSP in astro.config.ts, not here.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: GENERATED
