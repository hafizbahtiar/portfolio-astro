---
import { X } from "lucide-react";
// Inline (not bundled) so it re-runs on every ClientRouter swap; hashed in the CSP by astro.config.ts.
import alertToast from "../../scripts/inline/alert-toast.js?raw";
const { id = "ui-alert" } = Astro.props;
const alertId = id;
---

<div
  id={alertId}
  class="fixed right-6 bottom-6 z-50 max-md:bottom-[calc(5.5rem+env(safe-area-inset-bottom))] hidden opacity-0 translate-y-2 transition-all duration-300"
  role="alert"
  aria-live="polite"
>
  <div
    data-alert-panel
    class="w-90 max-w-[calc(100vw-3rem)] rounded-xl border border-gray-950/10 bg-white px-5 py-4 shadow-lg dark:border-white/10 dark:bg-gray-900"
  >
    <div class="flex items-start gap-3">
      <div
        data-alert-icon
        class="mt-0.5 shrink-0 rounded-full border px-2 py-0.5 font-mono text-[10px]/5 font-medium uppercase tracking-wider"
      >
        INFO
      </div>
      <!-- min-w-0: lets long words (links, error codes) wrap instead of pushing out of the panel. -->
      <div class="min-w-0 flex-1">
        <p
          data-alert-title
          class="text-sm font-semibold text-gray-950 wrap-break-word dark:text-white"
        >
          Notification
        </p>
        <p
          data-alert-message
          class="mt-1 max-h-48 overflow-y-auto text-sm whitespace-pre-line text-gray-500 wrap-break-word dark:text-gray-400"
        >
          Action completed.
        </p>
      </div>
      <button
        type="button"
        data-alert-close
        class="shrink-0 text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
        aria-label="Dismiss"
      >
        <X className="w-4 h-4" />
      </button>
    </div>
  </div>
</div>

<script is:inline data-alert-id={alertId} set:html={alertToast} />
