---
import { Plus } from "lucide-react";
import PrivateLayout from "../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../components/admin/AdminPageHeader.astro";
import { SubscriptionsTable } from "../../../components/admin/subscriptions/SubscriptionsTable";
---

<PrivateLayout title="Subscriptions">
  <div class="space-y-6">
    <AdminPageHeader
      title="Subscriptions"
      description="Every paid service in one place. A metered one (e.g. web search) has a monthly cap: once it is reached the API refuses that call until next month, so the bill cannot run past it."
    >
      <a
        slot="actions"
        href="/admin/subscriptions/edit"
        class="admin-btn admin-btn-primary"
      >
        <Plus className="w-4 h-4" />
        New subscription
      </a>
    </AdminPageHeader>

    <SubscriptionsTable client:load />
  </div>
</PrivateLayout>
