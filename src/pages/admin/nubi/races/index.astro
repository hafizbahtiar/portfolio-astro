---
import { MessageSquare, Plus } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import { RacesTable } from "../../../../components/admin/nubi/RacesTable";
---

<PrivateLayout title="Nubi Races">
  <div class="space-y-6">
    <AdminPageHeader
      title="Nubi Races"
      description="The race calendar on nubisport.hafizbahtiar.com/races. Paste an organiser's official page: the AI drafts the race, Clef warns when it is already saved."
    >
      <a
        slot="actions"
        href="/admin/nubi/races/edit"
        class="admin-btn admin-btn-primary"
      >
        <Plus className="w-4 h-4" />
        New race
      </a>
    </AdminPageHeader>

    <RacesTable client:only="react" />
  </div>
</PrivateLayout>
