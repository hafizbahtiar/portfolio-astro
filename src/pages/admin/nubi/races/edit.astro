---
// New (no ?id) and edit (?id=) in one page, like Subscriptions. AI draft: the organiser's page -> quoted values
// (checked by the API) with a Clef score each, plus saved races Clef thinks are the same event.
import { ArrowLeft, Check, LoaderCircle, Sparkles } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import DateInput from "../../../../components/ui/DateInput.astro";
---

<PrivateLayout title="Nubi Race">
  <div class="space-y-6">
    <AdminPageHeader
      title="Nubi Race"
      description="One race on Nubi /races. Copy only from the organiser's official page or its official registration page - not a blog or a listing site."
    >
      <a
        slot="actions"
        href="/admin/nubi/races"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>

    <form id="race-form" class="space-y-6" novalidate>
      <section class="admin-card">
        <h3 class="admin-card-title">Official page</h3>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="min-w-0 flex-1 space-y-2">
            <label class="admin-label" for="race-url">Link</label>
            <input
              id="race-url"
              name="url"
              type="url"
              required
              maxlength="500"
              placeholder="https://"
              class="admin-input"
            />
          </div>
          <button
            type="button"
            id="race-ai"
            class="admin-btn admin-btn-secondary"
          >
            <Sparkles className="h-4 w-4" />
            AI draft
          </button>
        </div>
        <p class="admin-help mt-2">
          The AI reads this page and fills only what it can quote from it. Clef
          scores each value and checks the saved races for the same event.
        </p>

        <div
          id="draft-loading"
          hidden
          class="mt-4 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300"
          aria-live="polite"
        >
          <LoaderCircle className="h-4 w-4 animate-spin text-sky-500" />
          Reading the page...
        </div>
        <div id="draft" hidden class="mt-4 space-y-4">
          <div
            id="draft-dups"
            hidden
            role="alert"
            class="rounded-lg bg-amber-500/10 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-500/30 dark:text-amber-200"
          >
            <p class="font-semibold">
              Already saved? Clef found a race that looks the same:
            </p>
            <ul id="draft-dups-list" class="mt-2 space-y-1"></ul>
            <p class="mt-2 text-xs">
              Edit that race instead of adding it again.
            </p>
          </div>
          <ul id="draft-items" class="space-y-3"></ul>
          <ul
            id="draft-notes"
            class="list-disc space-y-1 pl-5 text-sm text-amber-700 wrap-anywhere dark:text-amber-300"
          >
          </ul>
          <div class="flex justify-end">
            <button
              type="button"
              id="draft-fill"
              class="admin-btn admin-btn-primary"
            >
              <Check className="h-4 w-4" />
              Fill form
            </button>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Race</h3>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="space-y-2 md:col-span-2">
            <label class="admin-label" for="race-name">Name</label>
            <input
              id="race-name"
              name="name"
              required
              maxlength="120"
              class="admin-input"
            />
          </div>
          <DateInput label="Race day" name="raceDate" required />
          <div class="space-y-2">
            <label class="admin-label" for="race-start">First flag-off</label>
            <input
              id="race-start"
              name="startTime"
              type="time"
              required
              class="admin-input"
            />
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-venue">Venue</label>
            <input
              id="race-venue"
              name="venue"
              required
              maxlength="200"
              class="admin-input"
            />
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-state">State</label>
            <input
              id="race-state"
              name="state"
              required
              maxlength="60"
              list="race-states"
              class="admin-input"
            />
            <datalist id="race-states">
              {
                [
                  "Johor",
                  "Kedah",
                  "Kelantan",
                  "Kuala Lumpur",
                  "Labuan",
                  "Melaka",
                  "Negeri Sembilan",
                  "Pahang",
                  "Perak",
                  "Perlis",
                  "Pulau Pinang",
                  "Putrajaya",
                  "Sabah",
                  "Sarawak",
                  "Selangor",
                  "Terengganu",
                ].map((s) => <option value={s} />)
              }
            </datalist>
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-distances">Distances</label>
            <input
              id="race-distances"
              name="distances"
              required
              maxlength="200"
              placeholder="21K, 10K, 5K"
              class="admin-input"
            />
            <p class="admin-help">
              Comma-separated. The plan forms match 5K, 10K, 21K and 42K.
            </p>
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-fee">Fee</label>
            <input
              id="race-fee"
              name="fee"
              maxlength="200"
              placeholder="RM89 (21K), RM69 (10K)"
              class="admin-input"
            />
            <p class="admin-help">
              Only when the page states it (Malaysian price).
            </p>
          </div>
          <DateInput label="Registration closes" name="registrationCloses" />
          <DateInput label="Last checked" name="checkedOn" required />
        </div>
      </section>

      <div class="admin-form-actions">
        <button
          type="submit"
          id="race-submit"
          class="admin-btn admin-btn-primary"
        >
          <Check className="h-4 w-4" />
          Save
        </button>
      </div>
    </form>
  </div>
</PrivateLayout>

<script>
  import {
    showToast,
    formatErrorMessage,
    normalizeOptionalText,
  } from "../../../../lib/admin-ui";
  import { setupFormGuard } from "../../../../lib/form-guard";
  import { formErrors } from "../../../../lib/form-errors";
  import { nubiRacesService } from "../../../../lib/nubi-races";
  import type {
    NubiRacePayload,
    RaceDraft,
    RaceField,
  } from "../../../../types/nubi-races";

  const LABELS: Record<string, string> = {
    url: "Link",
    name: "Name",
    raceDate: "Race day",
    startTime: "First flag-off",
    venue: "Venue",
    state: "State",
    distances: "Distances",
    fee: "Fee",
    registrationCloses: "Registration closes",
    checkedOn: "Last checked",
  };
  const DATES = ["raceDate", "registrationCloses", "checkedOn"];
  const CHECKBOX =
    "mt-0.5 h-4 w-4 rounded-lg border-gray-950/10 dark:border-white/10 bg-white dark:bg-white/3 text-sky-600 focus:ring-sky-500/20";
  const SUPPORT_MIN = 0.7; // same cut as the crime draft: weaker matches start unticked
  const todayMY = () =>
    new Date(Date.now() + 8 * 3600_000).toISOString().slice(0, 10);
  const el = <T extends HTMLElement>(
    tag: string,
    className = "",
    text = "",
  ) => {
    const n = document.createElement(tag) as T;
    if (className) n.className = className;
    if (text) n.textContent = text;
    return n;
  };

  const init = async () => {
    const form = document.getElementById("race-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";
    const submit = document.getElementById("race-submit") as HTMLButtonElement;
    const field = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement;
    const set = (name: string, value: string) => {
      field(name).value = value;
      if (DATES.includes(name)) field(name).dispatchEvent(new Event("change")); // DatePicker shows script values on change
    };
    const errors = formErrors(form, { labels: LABELS });
    let id = Number(new URLSearchParams(location.search).get("id")) || null;

    if (id) {
      const r = await nubiRacesService.getById(id).catch(() => null);
      if (!r) {
        showToast({
          type: "error",
          title: "Not found",
          message: "This race no longer exists.",
        });
        return;
      }
      for (const name of [
        "url",
        "name",
        "raceDate",
        "startTime",
        "venue",
        "state",
        "fee",
        "registrationCloses",
        "checkedOn",
      ] as const)
        set(name, r[name] ?? "");
      set("distances", r.distances.join(", "));
    } else {
      set("checkedOn", todayMY());
      // From "Check for new races": ?url=<event page> - its draft starts below.
      const fromList = new URLSearchParams(location.search).get("url");
      if (fromList) set("url", fromList);
    }
    const guard = setupFormGuard(form);

    // ---- AI draft ----
    const aiBtn = document.getElementById("race-ai") as HTMLButtonElement;
    const loading = document.getElementById("draft-loading")!;
    const box = document.getElementById("draft")!;
    const items = document.getElementById("draft-items")!;
    const notes = document.getElementById("draft-notes")!;
    const dups = document.getElementById("draft-dups")!;
    const dupList = document.getElementById("draft-dups-list")!;
    let draft: RaceDraft | null = null;

    aiBtn.addEventListener("click", async () => {
      const url = field("url").value.trim();
      if (!/^https:\/\//i.test(url)) {
        showToast({
          type: "error",
          title: "Link needed",
          message: "Paste the organiser's https page first.",
        });
        return;
      }
      aiBtn.disabled = true;
      box.hidden = true;
      loading.hidden = false;
      try {
        draft = await nubiRacesService.extract([url], id ?? undefined);
        render(draft);
      } catch (error) {
        showToast({
          type: "error",
          title: "AI draft failed",
          message: formatErrorMessage(
            error,
            "The page could not be drafted.",
            LABELS,
          ).message,
        });
      } finally {
        aiBtn.disabled = false;
        loading.hidden = true;
      }
    });

    const render = (d: RaceDraft) => {
      dupList.replaceChildren(
        ...d.duplicates.map((x) => {
          const li = el("li");
          const a = el<HTMLAnchorElement>("a", "font-medium underline", x.name);
          a.href = `/admin/nubi/races/edit?id=${x.id}`;
          const why =
            x.sameEvent === 1
              ? "same official page"
              : x.sameEvent == null
                ? "same date (Clef off)"
                : `Clef ${Math.round(x.sameEvent * 100)}% same`;
          li.append(a, ` · ${x.raceDate} · ${why}`);
          return li;
        }),
      );
      dups.hidden = d.duplicates.length === 0;

      items.replaceChildren(
        ...(
          Object.entries(d.fields) as [
            RaceField,
            NonNullable<RaceDraft["fields"][RaceField]>,
          ][]
        ).map(([k, f]) => {
          const li = el(
            "li",
            "rounded-lg p-3 ring-1 ring-gray-950/10 dark:ring-white/10",
          );
          const head = el("label", "flex items-start gap-3");
          const tick = el<HTMLInputElement>("input", CHECKBOX);
          tick.type = "checkbox";
          tick.dataset.field = k;
          tick.checked = f.support == null || f.support >= SUPPORT_MIN;
          const body = el("div", "min-w-0 flex-1 space-y-1");
          const top = el("p", "flex flex-wrap items-center gap-2 text-sm");
          top.append(
            el("span", "text-xs text-gray-500 dark:text-gray-400", LABELS[k]),
          );
          top.append(
            el(
              "span",
              "font-medium text-gray-950 dark:text-white",
              Array.isArray(f.value) ? f.value.join(", ") : f.value,
            ),
          );
          if (f.support !== undefined) {
            const weak = f.support == null || f.support < SUPPORT_MIN;
            top.append(
              el(
                "span",
                `admin-pill ${weak ? "bg-amber-500/10 text-amber-700 dark:text-amber-300" : "admin-pill-ok"}`,
                f.support == null
                  ? "Clef -"
                  : `Clef ${Math.round(f.support * 100)}%`,
              ),
            );
          }
          body.append(
            top,
            el(
              "p",
              "text-xs text-gray-500 italic wrap-anywhere dark:text-gray-400",
              `"${f.quote}"`,
            ),
          );
          head.append(tick, body);
          li.append(head);
          return li;
        }),
      );
      notes.replaceChildren(
        ...d.rejected.map((r) =>
          el("li", "", `${LABELS[r.field] ?? r.field}: ${r.reason}`),
        ),
        ...d.sources
          .filter((s) => !s.ok)
          .map((s) => el("li", "", `${s.url}: ${s.error}`)),
      );
      if (!Object.keys(d.fields).length)
        notes.prepend(
          el(
            "li",
            "",
            "Nothing on this page could be quoted - fill the form by hand.",
          ),
        );
      box.hidden = false;
    };

    document.getElementById("draft-fill")!.addEventListener("click", () => {
      if (!draft) return;
      let n = 0;
      for (const cb of items.querySelectorAll<HTMLInputElement>(
        "input[data-field]",
      )) {
        if (!cb.checked) continue;
        const f = draft.fields[cb.dataset.field as RaceField]!;
        set(
          cb.dataset.field!,
          Array.isArray(f.value) ? f.value.join(", ") : f.value,
        );
        n++;
      }
      set("url", draft.url);
      set("checkedOn", todayMY()); // the page was just read
      showToast({
        type: "success",
        title: "Form filled",
        message: `${n} field(s) from the page. Check them, then Save.`,
      });
    });

    if (!id && field("url").value) aiBtn.click();

    // ---- Save ----
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const invalid = errors.check();
      if (invalid) {
        showToast({
          type: "error",
          title: `Check ${invalid.length} field(s)`,
          message: invalid.join("\n"),
        });
        return;
      }
      const payload: NubiRacePayload = {
        url: field("url").value.trim(),
        name: field("name").value.trim(),
        raceDate: field("raceDate").value,
        startTime: field("startTime").value,
        venue: field("venue").value.trim(),
        state: field("state").value.trim(),
        distances: field("distances")
          .value.split(",")
          .map((s) => s.trim())
          .filter(Boolean),
        fee: normalizeOptionalText(field("fee").value),
        registrationCloses: normalizeOptionalText(
          field("registrationCloses").value,
        ),
        checkedOn: field("checkedOn").value,
      };
      submit.disabled = true;
      try {
        const saved = id
          ? await nubiRacesService.update(id, payload)
          : await nubiRacesService.create(payload);
        if (!saved) throw new Error("Save failed");
        guard.updateInitialState();
        if (!id) history.replaceState(history.state, "", `?id=${saved.id}`);
        id = saved.id;
        showToast({
          type: "success",
          title: "Saved",
          message: `${saved.name} is on Nubi /races.`,
        });
      } catch (error) {
        const lines = errors.fromApi(error);
        showToast({
          type: "error",
          title: "Save failed",
          message: lines
            ? lines.join("\n")
            : formatErrorMessage(error, "Failed to save.", LABELS).message,
        });
      } finally {
        submit.disabled = false;
      }
    });
  };

  document.addEventListener("astro:page-load", () => void init());
</script>
