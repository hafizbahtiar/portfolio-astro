---
// New (no ?id) and edit (?id=) in one page, like Subscriptions. AI draft: the race page -> quoted values (checked by
// the API) with a Clef score each, plus saved races Clef thinks are the same event. ?url= (from "Check for new
// races") starts the draft on open.
import { ArrowLeft, Check, LoaderCircle, Plus, Sparkles } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import DateInput from "../../../../components/ui/DateInput.astro";
import Dropdown from "../../../../components/ui/Dropdown.astro";

const STATES = [
  "Johor",
  "Kedah",
  "Kelantan",
  "Kuala Lumpur",
  "Labuan",
  "Melaka",
  "Negeri Sembilan",
  "Pahang",
  "Perak",
  "Perlis",
  "Pulau Pinang",
  "Putrajaya",
  "Sabah",
  "Sarawak",
  "Selangor",
  "Terengganu",
];
---

<PrivateLayout title="Nubi Race">
  <div class="space-y-6">
    <AdminPageHeader
      title="Nubi Race"
      description="One race on Nubi /races. Copy from the organiser's page or its registration platform (RaceXAsia ...) - not a blog or news."
    >
      <a
        slot="actions"
        href="/admin/nubi/races"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>

    <form id="race-form" class="space-y-6" novalidate>
      <section class="admin-card">
        <h3 class="admin-card-title">Race page</h3>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="min-w-0 flex-1 space-y-2">
            <label class="admin-label" for="race-url">Link</label>
            <input
              id="race-url"
              name="url"
              type="url"
              required
              maxlength="500"
              placeholder="https://"
              class="admin-input"
            />
          </div>
          <button
            type="button"
            id="race-ai"
            class="admin-btn admin-btn-secondary"
          >
            <Sparkles className="h-4 w-4" />
            AI draft
          </button>
        </div>
        <label
          class="mt-3 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300"
        >
          <input
            id="race-search"
            type="checkbox"
            checked
            class="h-4 w-4 rounded-lg border-gray-950/10 dark:border-white/10 bg-white dark:bg-white/3 text-sky-600 focus:ring-sky-500/20"
          />
          Also search the web for this race (Parallel) - the organiser's own page
          often has the fees and flag-off times
        </label>
        <p class="admin-help mt-2">
          The AI reads the whole page and fills only what it can quote from it -
          categories with every fee tier too. Clef scores each value and checks
          the saved races for the same event.
        </p>

        <div
          id="draft-loading"
          hidden
          class="mt-4 flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300"
          aria-live="polite"
        >
          <LoaderCircle className="h-4 w-4 animate-spin text-sky-500" />
          Reading the page...
        </div>
        <div id="draft" hidden class="mt-4 space-y-4">
          <div
            id="draft-dups"
            hidden
            role="alert"
            class="rounded-lg bg-amber-500/10 px-4 py-3 text-sm text-amber-800 ring-1 ring-amber-500/30 dark:text-amber-200"
          >
            <p class="font-semibold">
              Already saved? Clef found a race that looks the same:
            </p>
            <ul id="draft-dups-list" class="mt-2 space-y-1"></ul>
            <p class="mt-2 text-xs">
              Edit that race instead of adding it again.
            </p>
          </div>
          <ul id="draft-items" class="space-y-3"></ul>
          <ul
            id="draft-notes"
            class="list-disc space-y-1 pl-5 text-sm text-amber-700 wrap-anywhere dark:text-amber-300"
          >
          </ul>
          <div class="flex justify-end">
            <button
              type="button"
              id="draft-fill"
              class="admin-btn admin-btn-primary"
            >
              <Check className="h-4 w-4" />
              Fill form
            </button>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Race</h3>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="space-y-2 md:col-span-2">
            <label class="admin-label" for="race-name">Name</label>
            <input
              id="race-name"
              name="name"
              required
              maxlength="120"
              class="admin-input"
            />
          </div>
          <DateInput label="Race day" name="raceDate" required />
          <DateInput label="Last day (multi-day race)" name="endDate" />
          <div class="space-y-2">
            <label class="admin-label" for="race-start">First flag-off</label>
            <input
              id="race-start"
              name="startTime"
              type="time"
              required
              class="admin-input"
            />
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-organiser">Organiser</label>
            <input
              id="race-organiser"
              name="organiser"
              maxlength="120"
              class="admin-input"
            />
          </div>
          <div class="space-y-2">
            <label class="admin-label" for="race-venue">Venue</label>
            <input
              id="race-venue"
              name="venue"
              required
              maxlength="200"
              class="admin-input"
            />
          </div>
          <Dropdown
            label="State"
            name="state"
            options={STATES.map((v) => ({ value: v, label: v }))}
            placeholder="Choose a state"
            required
            class="w-full"
          />
          <DateInput label="Registration opens" name="registrationOpens" />
          <DateInput label="Registration closes" name="registrationCloses" />
          <DateInput label="Last checked" name="checkedOn" required />
        </div>
      </section>

      <section class="admin-card">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div>
            <h3 class="admin-card-title mb-0">Categories</h3>
            <p class="admin-help">
              At least one. Age groups of the same distance are one category.
              Fees in RM (Malaysian price).
            </p>
          </div>
          <button
            type="button"
            id="cat-add"
            class="admin-btn admin-btn-secondary"
          >
            <Plus className="h-4 w-4" />
            Add category
          </button>
        </div>
        <ul id="cats" class="space-y-4"></ul>
      </section>

      <div class="admin-form-actions">
        <button
          type="submit"
          id="race-submit"
          class="admin-btn admin-btn-primary"
        >
          <Check className="h-4 w-4" />
          Save
        </button>
      </div>
    </form>
  </div>

  <template id="cat-tpl">
    <li class="admin-subcard space-y-4" data-cat>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="space-y-2">
          <label class="admin-label">Name</label>
          <input
            data-k="name"
            required
            maxlength="60"
            placeholder="21KM"
            aria-label="Category name"
            class="admin-input"
          />
        </div>
        <label class="space-y-2"
          ><span class="admin-label">Distance (km)</span>
          <input
            data-k="distanceKm"
            type="number"
            min="0"
            max="500"
            step="0.001"
            class="admin-input"
          /></label
        >
        <label class="space-y-2"
          ><span class="admin-label">Flag-off</span>
          <input data-k="startTime" type="time" class="admin-input" /></label
        >
      </div>
      <div class="space-y-2">
        <p class="admin-label">Fees</p>
        <ul data-fees class="space-y-2"></ul>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            data-fee-add
            class="admin-btn admin-btn-secondary">Add fee</button
          >
          <button
            type="button"
            data-cat-remove
            class="admin-btn admin-btn-danger">Remove category</button
          >
        </div>
      </div>
    </li>
  </template>
  <template id="fee-tpl">
    <li
      class="grid grid-cols-[minmax(0,1fr)_8rem_auto] items-center gap-2"
      data-fee
    >
      <input
        data-k="tier"
        required
        maxlength="40"
        placeholder="Early Bird"
        aria-label="Tier"
        class="admin-input"
      />
      <input
        data-k="amountRm"
        type="number"
        required
        min="0"
        step="0.01"
        placeholder="RM"
        aria-label="Amount (RM)"
        class="admin-input"
      />
      <button
        type="button"
        data-fee-remove
        class="admin-btn admin-btn-secondary"
        aria-label="Remove fee">×</button
      >
    </li>
  </template>
</PrivateLayout>

<script>
  import {
    showToast,
    formatErrorMessage,
    normalizeOptionalText,
  } from "../../../../lib/admin-ui";
  import { setupFormGuard } from "../../../../lib/form-guard";
  import { formErrors } from "../../../../lib/form-errors";
  import { nubiRacesService } from "../../../../lib/nubi-races";
  import type {
    NubiRacePayload,
    RaceCategory,
    RaceDraft,
    RaceField,
  } from "../../../../types/nubi-races";

  const LABELS: Record<string, string> = {
    url: "Link",
    name: "Name",
    raceDate: "Race day",
    endDate: "Last day",
    startTime: "First flag-off",
    venue: "Venue",
    state: "State",
    organiser: "Organiser",
    categories: "Categories",
    registrationOpens: "Registration opens",
    registrationCloses: "Registration closes",
    checkedOn: "Last checked",
  };
  // DatePicker / Dropdown show a value set from script only on `change`.
  const CUSTOM = [
    "raceDate",
    "endDate",
    "registrationOpens",
    "registrationCloses",
    "checkedOn",
    "state",
  ];
  const CHECKBOX =
    "mt-0.5 h-4 w-4 rounded-lg border-gray-950/10 dark:border-white/10 bg-white dark:bg-white/3 text-sky-600 focus:ring-sky-500/20";
  const SUPPORT_MIN = 0.7; // same cut as the crime draft: weaker matches start unticked
  const todayMY = () =>
    new Date(Date.now() + 8 * 3600_000).toISOString().slice(0, 10);
  const el = <T extends HTMLElement>(
    tag: string,
    className = "",
    text = "",
  ) => {
    const n = document.createElement(tag) as T;
    if (className) n.className = className;
    if (text) n.textContent = text;
    return n;
  };
  const rm = (n: number) => `RM${n % 1 ? n.toFixed(2) : n}`;
  const catText = (c: RaceCategory) =>
    [
      c.distanceKm != null ? `${c.distanceKm} km` : null,
      c.startTime,
      c.fees.map((f) => `${f.tier} ${rm(f.amountRm)}`).join(", ") || "no fee",
    ]
      .filter(Boolean)
      .join(" · ");

  const init = async () => {
    const form = document.getElementById("race-form") as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = "1";
    const submit = document.getElementById("race-submit") as HTMLButtonElement;
    const field = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement;
    const set = (name: string, value: string) => {
      field(name).value = value;
      if (CUSTOM.includes(name)) field(name).dispatchEvent(new Event("change"));
    };
    const errors = formErrors(form, {
      labels: LABELS,
      targets: { categories: "cats" },
    });
    let id = Number(new URLSearchParams(location.search).get("id")) || null;

    // ---- Categories editor ----
    const cats = document.getElementById("cats")!;
    const catTpl = document.getElementById("cat-tpl") as HTMLTemplateElement;
    const feeTpl = document.getElementById("fee-tpl") as HTMLTemplateElement;
    const changed = () =>
      form.dispatchEvent(new Event("input", { bubbles: true })); // the unsaved-changes guard
    const addFee = (list: HTMLElement, f?: RaceCategory["fees"][number]) => {
      const li = feeTpl.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLElement;
      if (f) {
        li.querySelector<HTMLInputElement>('[data-k="tier"]')!.value = f.tier;
        li.querySelector<HTMLInputElement>('[data-k="amountRm"]')!.value =
          String(f.amountRm);
      }
      li.querySelector("[data-fee-remove]")!.addEventListener(
        "click",
        () => (li.remove(), changed()),
      );
      list.append(li);
    };
    const addCat = (c?: RaceCategory) => {
      const li = catTpl.content.firstElementChild!.cloneNode(
        true,
      ) as HTMLElement;
      const input = (k: string) =>
        li.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
      const fees = li.querySelector<HTMLElement>("[data-fees]")!;
      if (c) {
        input("name").value = c.name;
        input("distanceKm").value =
          c.distanceKm == null ? "" : String(c.distanceKm);
        input("startTime").value = c.startTime ?? "";
        c.fees.forEach((f) => addFee(fees, f));
      }
      li.querySelector("[data-fee-add]")!.addEventListener(
        "click",
        () => (addFee(fees), changed()),
      );
      li.querySelector("[data-cat-remove]")!.addEventListener(
        "click",
        () => (li.remove(), changed()),
      );
      cats.append(li);
    };
    const setCats = (list: RaceCategory[]) => {
      cats.replaceChildren();
      list.forEach(addCat);
      if (!list.length) addCat();
    };
    const readCats = (): RaceCategory[] =>
      [...cats.querySelectorAll<HTMLElement>("[data-cat]")].map((li) => {
        const v = (k: string) =>
          li.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!.value.trim();
        return {
          name: v("name"),
          distanceKm: v("distanceKm") ? Number(v("distanceKm")) : null,
          startTime: v("startTime") || null,
          fees: [...li.querySelectorAll<HTMLElement>("[data-fee]")].map(
            (f) => ({
              tier: f
                .querySelector<HTMLInputElement>('[data-k="tier"]')!
                .value.trim(),
              amountRm: Number(
                f.querySelector<HTMLInputElement>('[data-k="amountRm"]')!.value,
              ),
            }),
          ),
        };
      });
    document
      .getElementById("cat-add")!
      .addEventListener("click", () => (addCat(), changed()));

    if (id) {
      const r = await nubiRacesService.getById(id).catch(() => null);
      if (!r) {
        showToast({
          type: "error",
          title: "Not found",
          message: "This race no longer exists.",
        });
        return;
      }
      for (const name of [
        "url",
        "name",
        "raceDate",
        "endDate",
        "startTime",
        "venue",
        "state",
        "organiser",
        "registrationOpens",
        "registrationCloses",
        "checkedOn",
      ] as const)
        set(name, r[name] ?? "");
      setCats(r.categories);
    } else {
      set("checkedOn", todayMY());
      setCats([]);
      // From "Check for new races": ?url=<event page> - its draft starts below.
      const fromList = new URLSearchParams(location.search).get("url");
      if (fromList) set("url", fromList);
    }
    const guard = setupFormGuard(form);

    // ---- AI draft ----
    const aiBtn = document.getElementById("race-ai") as HTMLButtonElement;
    const loading = document.getElementById("draft-loading")!;
    const box = document.getElementById("draft")!;
    const items = document.getElementById("draft-items")!;
    const notes = document.getElementById("draft-notes")!;
    const dups = document.getElementById("draft-dups")!;
    const dupList = document.getElementById("draft-dups-list")!;
    let draft: RaceDraft | null = null;
    /** " · web search: lumensports.my" when a value came from a page the search found, not the owner's link. */
    const from = (source: string) =>
      draft && source !== draft.url
        ? ` · web search: ${new URL(source).hostname.replace(/^www\./, "")}`
        : "";

    aiBtn.addEventListener("click", async () => {
      const url = field("url").value.trim();
      if (!/^https:\/\//i.test(url)) {
        showToast({
          type: "error",
          title: "Link needed",
          message: "Paste the race's https page first.",
        });
        return;
      }
      aiBtn.disabled = true;
      box.hidden = true;
      loading.hidden = false;
      try {
        const search = (
          document.getElementById("race-search") as HTMLInputElement
        ).checked;
        draft = await nubiRacesService.extract([url], id ?? undefined, search);
        render(draft);
      } catch (error) {
        showToast({
          type: "error",
          title: "AI draft failed",
          message: formatErrorMessage(
            error,
            "The page could not be drafted.",
            LABELS,
          ).message,
        });
      } finally {
        aiBtn.disabled = false;
        loading.hidden = true;
      }
    });

    /** One tickable draft row: label, value, Clef badge, quote. */
    const item = (
      key: string,
      label: string,
      value: string,
      quote: string,
      support: number | null | undefined,
    ) => {
      const li = el(
        "li",
        "rounded-lg p-3 ring-1 ring-gray-950/10 dark:ring-white/10",
      );
      const head = el("label", "flex items-start gap-3");
      const tick = el<HTMLInputElement>("input", CHECKBOX);
      tick.type = "checkbox";
      tick.dataset.item = key;
      tick.checked = support == null || support >= SUPPORT_MIN;
      const body = el("div", "min-w-0 flex-1 space-y-1");
      const top = el("p", "flex flex-wrap items-center gap-2 text-sm");
      top.append(
        el("span", "text-xs text-gray-500 dark:text-gray-400", label),
        el("span", "font-medium text-gray-950 dark:text-white", value),
      );
      if (support !== undefined) {
        const weak = support == null || support < SUPPORT_MIN;
        top.append(
          el(
            "span",
            `admin-pill ${weak ? "bg-amber-500/10 text-amber-700 dark:text-amber-300" : "admin-pill-ok"}`,
            support == null ? "Clef -" : `Clef ${Math.round(support * 100)}%`,
          ),
        );
      }
      body.append(
        top,
        el(
          "p",
          "text-xs text-gray-500 italic wrap-anywhere dark:text-gray-400",
          `"${quote}"`,
        ),
      );
      head.append(tick, body);
      li.append(head);
      return li;
    };

    const render = (d: RaceDraft) => {
      dupList.replaceChildren(
        ...d.duplicates.map((x) => {
          const li = el("li");
          const a = el<HTMLAnchorElement>("a", "font-medium underline", x.name);
          a.href = `/admin/nubi/races/edit?id=${x.id}`;
          const why =
            x.sameEvent === 1
              ? "same page"
              : x.sameEvent == null
                ? "same date (Clef off)"
                : `Clef ${Math.round(x.sameEvent * 100)}% same`;
          li.append(a, ` · ${x.raceDate} · ${why}`);
          return li;
        }),
      );
      dups.hidden = d.duplicates.length === 0;
      items.replaceChildren(
        ...(
          Object.entries(d.fields) as [
            RaceField,
            NonNullable<RaceDraft["fields"][RaceField]>,
          ][]
        ).map(([k, f]) =>
          item(
            `f:${k}`,
            LABELS[k] + from(f.source),
            f.value,
            f.quote,
            f.support,
          ),
        ),
        ...d.categories.map((c, i) =>
          item(
            `c:${i}`,
            `Category ${c.name}${from(c.source)}`,
            catText(c),
            c.quote,
            c.support,
          ),
        ),
      );
      const searched = d.sources.filter((s) => s.found && s.ok && !s.dropped);
      notes.replaceChildren(
        ...(d.search?.error
          ? [el("li", "", `Web search: ${d.search.error}`)]
          : []),
        ...(d.search && !searched.length && !d.search.error
          ? [el("li", "", "Web search found no other page about this race.")]
          : []),
        ...d.sources
          .filter((s) => s.dropped === "other_race")
          .map((s) => el("li", "", `Skipped (not this race / year): ${s.url}`)),
        ...d.rejected.map((r) =>
          el("li", "", `${LABELS[r.field] ?? r.field}: ${r.reason}`),
        ),
        ...d.sources
          .filter((s) => !s.ok)
          .map((s) => el("li", "", `${s.url}: ${s.error}`)),
      );
      if (!Object.keys(d.fields).length && !d.categories.length)
        notes.prepend(
          el(
            "li",
            "",
            "Nothing on this page could be quoted - fill the form by hand.",
          ),
        );
      box.hidden = false;
    };

    document.getElementById("draft-fill")!.addEventListener("click", () => {
      if (!draft) return;
      let n = 0;
      const picked: RaceCategory[] = [];
      for (const cb of items.querySelectorAll<HTMLInputElement>(
        "input[data-item]",
      )) {
        if (!cb.checked) continue;
        const [kind, key] = cb.dataset.item!.split(":");
        if (kind === "f") set(key, draft.fields[key as RaceField]!.value);
        else {
          const {
            source: _s,
            quote: _q,
            support: _p,
            ...c
          } = draft.categories[Number(key)];
          picked.push(c);
        }
        n++;
      }
      if (picked.length) setCats(picked); // ticked categories replace the list
      set("url", draft.url);
      set("checkedOn", todayMY()); // the page was just read
      changed();
      showToast({
        type: "success",
        title: "Form filled",
        message: `${n} value(s) from the page. Check them, then Save.`,
      });
    });

    if (!id && field("url").value) aiBtn.click();

    // ---- Save ----
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const categories = readCats();
      const invalid = [
        ...(errors.check() ?? []),
        ...(categories.length ? [] : ["Categories: add at least one"]),
      ];
      if (invalid.length) {
        showToast({
          type: "error",
          title: `Check ${invalid.length} field(s)`,
          message: invalid.join("\n"),
        });
        return;
      }
      const text = (name: string) => normalizeOptionalText(field(name).value);
      const payload: NubiRacePayload = {
        url: field("url").value.trim(),
        name: field("name").value.trim(),
        raceDate: field("raceDate").value,
        endDate: text("endDate"),
        startTime: field("startTime").value,
        venue: field("venue").value.trim(),
        state: field("state").value.trim(),
        organiser: text("organiser"),
        categories,
        registrationOpens: text("registrationOpens"),
        registrationCloses: text("registrationCloses"),
        checkedOn: field("checkedOn").value,
      };
      submit.disabled = true;
      try {
        const saved = id
          ? await nubiRacesService.update(id, payload)
          : await nubiRacesService.create(payload);
        if (!saved) throw new Error("Save failed");
        guard.updateInitialState(); // no "unsaved changes" prompt on the way out
        window.location.href = "/admin/nubi/races"; // back to the list, like Quotes
      } catch (error) {
        const lines = errors.fromApi(error);
        showToast({
          type: "error",
          title: "Save failed",
          message: lines
            ? lines.join("\n")
            : formatErrorMessage(error, "Failed to save.", LABELS).message,
        });
      } finally {
        submit.disabled = false;
      }
    });
  };

  document.addEventListener("astro:page-load", () => void init());
</script>
