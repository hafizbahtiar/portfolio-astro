---
// New (no ?id) and edit (?id=) in one page. Photos need a saved record, so the
// photo card appears after the first save.
import { ArrowLeft, Check, ImagePlus, Plus, Sparkles } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import AlertToast from "../../../../components/ui/AlertToast.astro";
---

<PrivateLayout title="Drunk Driver Record">
  <div class="space-y-6">
    <AdminPageHeader
      title="Drunk Driver Record"
      description="Everything here is private except the name, conviction date and source links - and only once published."
    >
      <a
        slot="actions"
        href="/admin/crime/drunk-drivers"
        class="admin-btn admin-btn-secondary"
      >
        <ArrowLeft className="w-4 h-4" />
        Back to list
      </a>
    </AdminPageHeader>

    <section id="dd-ai" class="admin-card hidden" aria-live="polite">
      <h3 class="admin-card-title">AI draft - check every field</h3>
      <ul id="dd-ai-fields" class="space-y-3"></ul>
      <ul
        id="dd-ai-notes"
        class="mt-4 space-y-1 text-sm text-amber-700 dark:text-amber-300"
      >
      </ul>
    </section>

    <form id="dd-form" class="space-y-8">
      <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_360px] gap-6">
        <div class="admin-card">
          <h3 class="admin-card-title">Person &amp; incident</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2 md:col-span-2">
              <label class="admin-label" for="dd-name">Full name</label>
              <input
                id="dd-name"
                name="fullName"
                required
                maxlength="120"
                class="admin-input"
              />
              <p class="admin-help">
                Public once published - exactly as in the court record.
              </p>
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-ic">IC number</label>
              <input
                id="dd-ic"
                name="icNumber"
                inputmode="numeric"
                maxlength="14"
                placeholder="900101-14-5678"
                class="admin-input"
                autocomplete="off"
              />
              <p class="admin-help">
                Optional. Never public - visitors only see that an IC is on
                file.
              </p>
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-dob">Date of birth</label>
              <input
                id="dd-dob"
                type="date"
                name="dateOfBirth"
                class="admin-input"
              />
              <p class="admin-help">
                Filled from the IC when empty. Never public.
              </p>
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-age">Age</label>
              <input
                id="dd-age"
                type="number"
                name="age"
                min="0"
                max="120"
                class="admin-input"
              />
              <p class="admin-help">
                At the incident - worked out from the date of birth when there
                is one.
              </p>
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-incident">Incident date</label>
              <input
                id="dd-incident"
                type="date"
                name="incidentDate"
                class="admin-input"
              />
            </div>
            <div class="space-y-2 md:col-span-2">
              <label class="admin-label" for="dd-location">Location</label>
              <input
                id="dd-location"
                name="location"
                maxlength="200"
                class="admin-input"
              />
            </div>
            <div class="space-y-2 md:col-span-2">
              <label class="admin-label" for="dd-details">Details</label>
              <textarea
                id="dd-details"
                name="details"
                maxlength="2000"
                rows="5"
                class="admin-input"></textarea>
              <p class="admin-help">
                Private notes (vehicle, sentence, victims...).
              </p>
            </div>
          </div>
        </div>

        <div class="admin-card">
          <h3 class="admin-card-title">Conviction &amp; publishing</h3>
          <div class="grid grid-cols-1 gap-6">
            <div class="space-y-2">
              <label class="admin-label" for="dd-convicted"
                >Conviction date</label
              >
              <input
                id="dd-convicted"
                type="date"
                name="convictedOn"
                class="admin-input"
              />
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-case">Case reference</label>
              <input
                id="dd-case"
                name="caseReference"
                maxlength="100"
                placeholder="Court + case no."
                class="admin-input"
              />
            </div>
            <div class="space-y-2">
              <label class="admin-label" for="dd-sources">Sources</label>
              <textarea
                id="dd-sources"
                name="sources"
                rows="4"
                placeholder="https://... (one link per line, first = main)"
                class="admin-input font-mono text-xs"></textarea>
              <p class="admin-help">
                Court records or news reports naming this person - up to 10.
              </p>
              <button
                type="button"
                id="dd-ai-btn"
                class="admin-btn admin-btn-secondary w-full"
              >
                <Sparkles className="h-4 w-4" />
                <span id="dd-ai-label">Fill from sources (AI)</span>
              </button>
              <p class="admin-help">
                Reads the first 5 links. Fills empty fields only; every value
                comes with its quote. IC is never filled by AI.
              </p>
            </div>
            <label class="flex items-center gap-3">
              <input
                type="checkbox"
                name="published"
                class="h-4 w-4 rounded-lg border-gray-950/10 dark:border-white/10 bg-white dark:bg-white/3 text-sky-600 focus:ring-sky-500/20"
              />
              <span class="text-sm text-gray-700 dark:text-gray-300"
                >Published (needs conviction date, case reference and a source)</span
              >
            </label>
          </div>
        </div>
      </div>

      <div class="admin-card">
        <h3 class="admin-card-title">Victims</h3>
        <p class="admin-help mb-4">
          Owner-only - never on the public page. Name is optional ("seorang
          wanita"). Date of birth comes from the IC, age from the date of birth.
        </p>
        <ul id="dd-victims" class="space-y-4"></ul>
        <button
          type="button"
          id="dd-victim-add"
          class="admin-btn admin-btn-secondary mt-4"
        >
          <Plus className="h-4 w-4" />
          Add victim
        </button>
      </div>

      <div class="admin-form-actions">
        <button
          type="submit"
          id="dd-submit"
          class="admin-btn admin-btn-primary"
        >
          <Check className="h-4 w-4" />
          Save
        </button>
      </div>
    </form>

    <section id="dd-photos" class="admin-card hidden">
      <h3 class="admin-card-title">Evidence photos</h3>
      <p class="admin-help mb-4">
        Private - never shown on the public page. Up to 10, JPEG/PNG/WebP/GIF,
        resized before upload.
      </p>
      <label class="admin-btn admin-btn-secondary cursor-pointer">
        <ImagePlus className="h-4 w-4" />
        <span id="dd-photo-label">Add photos</span>
        <input
          id="dd-photo-input"
          type="file"
          accept="image/jpeg,image/png,image/webp,image/gif"
          multiple
          class="sr-only"
        />
      </label>
      <ul
        id="dd-photo-grid"
        class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5"
      >
      </ul>
    </section>
  </div>
  <template id="dd-victim-row">
    <li class="rounded-lg p-4 ring-1 ring-gray-950/10 dark:ring-white/10">
      <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <label class="space-y-2"
          ><span class="admin-label">Name</span>
          <input
            data-v="fullName"
            name="victim.fullName"
            maxlength="120"
            class="admin-input"
          /></label
        >
        <label class="space-y-2"
          ><span class="admin-label">IC number</span>
          <input
            data-v="icNumber"
            name="victim.icNumber"
            inputmode="numeric"
            maxlength="14"
            autocomplete="off"
            class="admin-input"
          /></label
        >
        <label class="space-y-2"
          ><span class="admin-label">Outcome</span>
          <select data-v="outcome" name="victim.outcome" class="admin-input">
            <option value="">-</option>
            <option value="killed">Killed</option>
            <option value="seriously_injured">Seriously injured</option>
            <option value="injured">Injured</option>
            <option value="unhurt">Unhurt</option>
          </select></label
        >
        <label class="space-y-2"
          ><span class="admin-label">Date of birth</span>
          <input
            data-v="dateOfBirth"
            name="victim.dateOfBirth"
            type="date"
            class="admin-input"
          /></label
        >
        <label class="space-y-2"
          ><span class="admin-label">Age</span>
          <input
            data-v="age"
            name="victim.age"
            type="number"
            min="0"
            max="120"
            class="admin-input"
          /></label
        >
        <label class="space-y-2 md:col-span-3"
          ><span class="admin-label">Notes</span>
          <input
            data-v="notes"
            name="victim.notes"
            maxlength="1000"
            class="admin-input"
          /></label
        >
      </div>
      <button
        type="button"
        data-remove
        class="admin-btn admin-btn-secondary mt-3 text-xs">Remove victim</button
      >
    </li>
  </template>
  <AlertToast id="dd-alert" />
</PrivateLayout>

<script>
  import {
    showToast,
    confirmDialog,
    formatErrorMessage,
    normalizeOptionalText,
  } from "../../../../lib/admin-ui";
  import { setupFormGuard } from "../../../../lib/form-guard";
  import { compressImage } from "../../../../lib/upload";
  import { drunkDriversService } from "../../../../lib/crime";
  import { ageOn, dobFromIc } from "../../../../lib/mykad";
  import type {
    DrunkDriver,
    DrunkDriverPayload,
    DrunkDriverVictim,
    VictimOutcome,
  } from "../../../../types/crime";

  const LABELS: Record<string, string> = {
    fullName: "Full name",
    icNumber: "IC number",
    dateOfBirth: "Date of birth",
    age: "Age",
    victims: "Victims",
    incidentDate: "Incident date",
    location: "Location",
    details: "Details",
    convictedOn: "Conviction date",
    caseReference: "Case reference",
    sources: "Sources",
  };
  const TEXT_FIELDS = [
    "fullName",
    "icNumber",
    "dateOfBirth",
    "incidentDate",
    "location",
    "details",
    "convictedOn",
    "caseReference",
  ] as const;

  // <ClientRouter> runs a page's bundled script once per session - init on every visit.
  async function initPage() {
    if (
      location.pathname.replace(/\/+$/, "") !==
      "/admin/crime/drunk-drivers/edit"
    )
      return;
    const form = document.getElementById("dd-form") as HTMLFormElement;
    const submit = document.getElementById("dd-submit") as HTMLButtonElement;
    const photos = document.getElementById("dd-photos")!;
    const grid = document.getElementById("dd-photo-grid")!;
    const input = document.getElementById("dd-photo-input") as HTMLInputElement;
    const inputLabel = document.getElementById("dd-photo-label")!;
    const toast = (o: Omit<Parameters<typeof showToast>[0], "id">) =>
      showToast({ ...o, id: "dd-alert" });

    let id = Number(new URLSearchParams(location.search).get("id")) || null;
    let record: DrunkDriver | null = null;

    const field = (name: string) =>
      form.elements.namedItem(name) as HTMLInputElement;

    // Date of birth from the IC when empty; age from the date of birth (at the incident, else today).
    // The API does the same on save - this is the live preview.
    const today = () => new Date().toISOString().slice(0, 10);
    const autoPerson = (
      ic: HTMLInputElement,
      dob: HTMLInputElement,
      age: HTMLInputElement,
    ) => {
      const update = () => {
        // Follow the IC while the date is still the one taken from it; a typed date is left alone.
        if (!dob.value || dob.value === dob.dataset.fromIc) {
          dob.value = dob.dataset.fromIc = dobFromIc(ic.value) ?? "";
        }
        const computed = dob.value
          ? ageOn(dob.value, field("incidentDate").value || today())
          : null;
        age.readOnly = computed !== null;
        if (computed !== null) age.value = String(computed);
      };
      ic.addEventListener("change", update);
      dob.addEventListener("change", update);
      field("incidentDate").addEventListener("change", update);
      return update;
    };
    const driverAuto = autoPerson(
      field("icNumber"),
      field("dateOfBirth"),
      field("age"),
    );

    const victimList = document.getElementById("dd-victims")!;
    const victimTemplate = document.getElementById(
      "dd-victim-row",
    ) as HTMLTemplateElement;
    const addVictim = (v: Partial<DrunkDriverVictim> = {}) => {
      const li = (
        victimTemplate.content.firstElementChild as HTMLElement
      ).cloneNode(true) as HTMLElement;
      const input = (k: string) =>
        li.querySelector(`[data-v="${k}"]`) as HTMLInputElement;
      for (const k of [
        "fullName",
        "icNumber",
        "dateOfBirth",
        "age",
        "outcome",
        "notes",
      ] as const) {
        input(k).value = v[k] == null ? "" : String(v[k]);
      }
      li.querySelector("[data-remove]")!.addEventListener("click", () => {
        li.remove();
        form.dispatchEvent(new Event("change")); // form guard
      });
      victimList.append(li);
      autoPerson(input("icNumber"), input("dateOfBirth"), input("age"))();
      return li;
    };
    document.getElementById("dd-victim-add")!.addEventListener("click", () => {
      addVictim().querySelector("input")?.focus();
    });
    const numberOrNull = (v: string) => (v.trim() === "" ? null : Number(v));
    const collectVictims = (): DrunkDriverVictim[] =>
      [...victimList.querySelectorAll("li")]
        .map((li) => {
          const val = (k: string) =>
            (
              li.querySelector(`[data-v="${k}"]`) as HTMLInputElement
            ).value.trim();
          return {
            fullName: val("fullName") || null,
            icNumber: val("icNumber") || null,
            dateOfBirth: val("dateOfBirth") || null,
            age: numberOrNull(val("age")),
            outcome: (val("outcome") || null) as VictimOutcome | null,
            notes: val("notes") || null,
          };
        })
        .filter((v) => Object.values(v).some((x) => x !== null)); // an untouched row is not a victim

    const sourceList = () =>
      field("sources")
        .value.split(/\s+/)
        .map((s) => s.trim())
        .filter(Boolean);

    // AI draft: fill empty fields, show each value with its quote; a field the owner
    // already filled keeps its value and gets a "Use" button instead.
    const aiBtn = document.getElementById("dd-ai-btn") as HTMLButtonElement;
    const aiLabel = document.getElementById("dd-ai-label")!;
    const aiPanel = document.getElementById("dd-ai")!;
    const aiFields = document.getElementById("dd-ai-fields")!;
    const aiNotes = document.getElementById("dd-ai-notes")!;
    const host = (url: string) => {
      try {
        return new URL(url).hostname.replace(/^www\./, "");
      } catch {
        return url;
      }
    };
    const setField = (name: string, value: string) => {
      const el = field(name);
      el.value = value;
      el.dispatchEvent(new Event("input", { bubbles: true })); // form guard sees the change
    };

    aiBtn.addEventListener("click", async () => {
      const urls = sourceList();
      if (!urls.length) {
        toast({
          type: "warning",
          title: "No sources",
          message: "Paste at least one link first.",
        });
        field("sources").focus();
        return;
      }
      aiBtn.disabled = true;
      aiLabel.textContent = "Reading sources...";
      try {
        const draft = await drunkDriversService.extract(urls.slice(0, 5));
        const rows = Object.entries(draft.fields).map(([name, f]) => {
          const li = document.createElement("li");
          li.className =
            "rounded-lg p-3 ring-1 ring-gray-950/10 dark:ring-white/10";
          const head = document.createElement("p");
          head.className = "text-sm";
          const label = document.createElement("strong");
          label.textContent = `${LABELS[name] ?? name}: `;
          head.append(label, f.value);
          const quote = document.createElement("blockquote");
          quote.className =
            "mt-1 border-l-2 border-sky-500/40 pl-2 text-xs text-gray-600 dark:text-gray-400";
          quote.textContent = `"${f.quote}" - `;
          const src = document.createElement("a");
          src.href = f.source;
          src.target = "_blank";
          src.rel = "noopener noreferrer";
          src.className = "link";
          src.textContent = host(f.source);
          quote.append(src);
          li.append(head, quote);
          const current = field(name).value.trim();
          const status = document.createElement("p");
          status.className = "mt-2 text-xs text-gray-500 dark:text-gray-400";
          if (!current) {
            setField(name, f.value);
            status.textContent = "Filled in the form.";
          } else if (current !== f.value) {
            status.textContent = `Kept your value "${current}". `;
            const use = document.createElement("button");
            use.type = "button";
            use.className = "link";
            use.textContent = "Use AI value";
            use.addEventListener("click", () => {
              setField(name, f.value);
              status.textContent = "Replaced with the AI value.";
            });
            status.append(use);
          } else {
            status.textContent = "Same as your value.";
          }
          li.append(status);
          return li;
        });
        // Victims: added straight away when the list is empty, else each gets an "Add" button.
        const outcomeText: Record<string, string> = {
          killed: "killed",
          seriously_injured: "seriously injured",
          injured: "injured",
          unhurt: "unhurt",
        };
        const autoAdd = victimList.children.length === 0;
        for (const v of draft.victims) {
          const li = document.createElement("li");
          li.className =
            "rounded-lg p-3 ring-1 ring-gray-950/10 dark:ring-white/10";
          const head = document.createElement("p");
          head.className = "text-sm";
          const label = document.createElement("strong");
          label.textContent = "Victim: ";
          head.append(
            label,
            [
              v.fullName ?? "(no name)",
              v.age != null ? `${v.age} yrs` : null,
              v.outcome ? outcomeText[v.outcome] : null,
            ]
              .filter(Boolean)
              .join(", "),
          );
          const quote = document.createElement("blockquote");
          quote.className =
            "mt-1 border-l-2 border-sky-500/40 pl-2 text-xs text-gray-600 dark:text-gray-400";
          quote.textContent = `"${v.quote}" - ${host(v.source)}`;
          const status = document.createElement("p");
          status.className = "mt-2 text-xs text-gray-500 dark:text-gray-400";
          const add = () => {
            addVictim({ fullName: v.fullName, age: v.age, outcome: v.outcome });
            form.dispatchEvent(new Event("change"));
            status.textContent = "Added to Victims.";
          };
          if (autoAdd) add();
          else {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.className = "link";
            btn.textContent = "Add to Victims";
            btn.addEventListener("click", add, { once: true });
            status.append(btn);
          }
          li.append(head, quote, status);
          rows.push(li);
        }
        aiFields.replaceChildren(...rows);
        if (!rows.length)
          aiFields.textContent =
            "Nothing could be confirmed from these pages - fill the form by hand.";
        aiNotes.replaceChildren(
          ...[
            ...draft.conflicts.map(
              (c) => `Conflict (${LABELS[c.field] ?? c.field}): ${c.note}`,
            ),
            ...draft.rejected.map(
              (r) => `Dropped ${LABELS[r.field] ?? r.field}: ${r.reason}`,
            ),
            ...draft.sources
              .filter((s) => !s.ok)
              .map((s) => `Could not read ${host(s.url)}: ${s.error}`),
          ].map((t) =>
            Object.assign(document.createElement("li"), { textContent: t }),
          ),
        );
        aiPanel.classList.remove("hidden");
        aiPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      } catch (error) {
        toast({
          type: "error",
          title: "AI draft failed",
          message: formatErrorMessage(error, "Could not read the sources.", {})
            .message,
        });
      } finally {
        aiBtn.disabled = false;
        aiLabel.textContent = "Fill from sources (AI)";
      }
    });

    const renderPhotos = () => {
      if (!id || !record) return;
      photos.classList.remove("hidden");
      grid.replaceChildren(
        ...record.photos.map((p) => {
          const li = document.createElement("li");
          li.className =
            "relative overflow-hidden rounded-lg ring-1 ring-gray-950/10 dark:ring-white/10";
          const link = document.createElement("a");
          link.href = drunkDriversService.photoUrl(id!, p.id);
          link.target = "_blank";
          link.rel = "noopener";
          const img = document.createElement("img");
          img.src = link.href;
          img.alt = `Evidence photo ${p.id}`;
          img.loading = "lazy";
          img.className = "aspect-square w-full object-cover";
          link.append(img);
          const del = document.createElement("button");
          del.type = "button";
          del.className =
            "admin-btn admin-btn-secondary absolute right-1 top-1 px-2! py-1! text-xs";
          del.textContent = "Delete";
          del.addEventListener("click", async () => {
            if (
              !(await confirmDialog({
                title: "Delete photo",
                message: "Delete this photo?",
                confirmText: "Delete",
                variant: "danger",
              }))
            )
              return;
            try {
              await drunkDriversService.removePhoto(id!, p.id);
              record!.photos = record!.photos.filter((x) => x.id !== p.id);
              renderPhotos();
            } catch {
              toast({
                type: "error",
                title: "Delete failed",
                message: "Failed to delete the photo.",
              });
            }
          });
          li.append(link, del);
          return li;
        }),
      );
    };

    if (id) {
      record = await drunkDriversService.getById(id).catch(() => null);
      if (!record) {
        toast({
          type: "error",
          title: "Not found",
          message: "Record was not found.",
        });
        return;
      }
      for (const name of TEXT_FIELDS) field(name).value = record[name] ?? "";
      field("sources").value = record.sources.join("\n");
      field("age").value = record.age == null ? "" : String(record.age);
      record.victims.forEach((v) => addVictim(v));
      driverAuto();
      field("published").checked = record.published;
      renderPhotos();
    }
    const guard = setupFormGuard(form);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      const fd = new FormData(form);
      const text = (name: string) => normalizeOptionalText(fd.get(name) ?? "");
      const payload: DrunkDriverPayload = {
        fullName: text("fullName") ?? "",
        icNumber: text("icNumber"),
        dateOfBirth: text("dateOfBirth"),
        age: numberOrNull(String(fd.get("age") ?? "")),
        incidentDate: text("incidentDate"),
        location: text("location"),
        details: text("details"),
        convictedOn: text("convictedOn"),
        caseReference: text("caseReference"),
        sources: sourceList(),
        victims: collectVictims(),
        published: fd.has("published"),
      };
      try {
        const saved = id
          ? await drunkDriversService.update(id, payload)
          : await drunkDriversService.create(payload);
        if (!saved) throw new Error("Save failed");
        guard.updateInitialState();
        const created = !id;
        id = saved.id;
        record = saved;
        if (created) history.replaceState(history.state, "", `?id=${id}`);
        renderPhotos();
        toast({
          type: "success",
          title: "Saved",
          message: created
            ? "Saved - you can add photos now."
            : "Record updated.",
        });
      } catch (error) {
        const { message, field: bad } = formatErrorMessage(
          error,
          "Failed to save.",
          LABELS,
        );
        if (bad) (form.elements.namedItem(bad) as HTMLElement | null)?.focus();
        toast({ type: "error", title: "Save failed", message });
      } finally {
        submit.disabled = false;
      }
    });

    input.addEventListener("change", async () => {
      const files = [...(input.files ?? [])];
      input.value = "";
      if (!files.length || !id || !record) return;
      inputLabel.textContent = "Uploading...";
      try {
        // Quality 95% (owner choice, evidence detail); re-encoding also drops EXIF (GPS, device).
        const ready = await Promise.all(
          files.map(async (f) => (await compressImage(f, 2560, 0.95)).file),
        );
        record.photos.push(
          ...(await drunkDriversService.uploadPhotos(id, ready)),
        );
        renderPhotos();
      } catch (error) {
        toast({
          type: "error",
          title: "Upload failed",
          message: formatErrorMessage(error, "Failed to upload.", {}).message,
        });
      } finally {
        inputLabel.textContent = "Add photos";
      }
    });
  }
  document.addEventListener("astro:page-load", initPage);
</script>
