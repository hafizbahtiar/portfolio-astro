---
import { Plus } from "lucide-react";
import PrivateLayout from "../../../../layouts/PrivateLayout.astro";
import AdminPageHeader from "../../../../components/admin/AdminPageHeader.astro";
import { DrunkDriversTable } from "../../../../components/admin/crime/DrunkDriversTable";
---

<PrivateLayout title="Drunk Drivers">
  <div class="space-y-6">
    <AdminPageHeader
      title="Drunk Drivers"
      description="Court-convicted cases for the public list (/pemandu-mabuk). The public sees only the name, an IC mask, the conviction date and the source. Turn the page on or off under System -> Showcase Modules."
    >
      <a
        slot="actions"
        href="/admin/crime/drunk-drivers/edit"
        class="admin-btn admin-btn-primary"
      >
        <Plus className="w-4 h-4" />
        New record
      </a>
    </AdminPageHeader>

    <DrunkDriversTable client:load />
  </div>
</PrivateLayout>
