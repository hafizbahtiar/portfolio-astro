---
import AccountLayout from "../layouts/AccountLayout.astro";
import { RegisterForm } from "../components/account/RegisterForm";
import { TURNSTILE_SITE_KEY as siteKey } from "../lib/constants";
---

<AccountLayout
  title="Forgot password"
  description="Reset the password of your hafizbahtiar.com account."
  variant="auth"
  switchTo={{ href: "/login", label: "Sign in" }}
>
  <RegisterForm client:load siteKey={siteKey} mode="forgot" />
</AccountLayout>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
  async
  defer></script>
