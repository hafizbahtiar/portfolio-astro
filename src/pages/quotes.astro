---
export const prerender = false;
import PublicLayout from "../layouts/PublicLayout.astro";
import SectionHeader from "../components/layout/SectionHeader.astro";
import { getPublicQuotes } from "../lib/public-content";
import { categoryLabel, sortCategories } from "../lib/quotes";

// API order (newest first) is kept as-is.
const quotes = await getPublicQuotes();
const quoteCategories = (tags: { category: string | null }[]) => [
  ...new Set(tags.map((t) => t.category ?? "other")),
];
const presentCategories = sortCategories(
  quotes.flatMap((q) => quoteCategories(q.tags)),
);

const chipClass =
  "rounded-full px-3 py-1 text-sm/6 font-medium text-gray-600 ring-1 ring-gray-950/10 ring-inset transition-colors hover:text-gray-950 aria-pressed:bg-sky-500/10 aria-pressed:text-sky-700 aria-pressed:ring-sky-500/30 dark:text-gray-400 dark:ring-white/10 dark:hover:text-white dark:aria-pressed:text-sky-400 dark:aria-pressed:ring-sky-400/30";
---

<PublicLayout
  title="Quotes | Hafiz Bahtiar"
  description="A small collection of quotes worth keeping - from books, history, anime and life."
>
  <div class="h-16 sm:h-24"></div>
  <SectionHeader
    as="h1"
    eyebrow="Quotes"
    title="Words worth keeping"
    description="A small collection of lines from books, history, anime and life."
  />
  <div class="h-12"></div>

  {
    quotes.length > 0 ? (
      <>
        {presentCategories.length > 0 && (
          <div class="line-y">
            <div
              role="group"
              aria-label="Filter quotes by category"
              class="container-main flex flex-wrap gap-2 py-3"
            >
              <button
                type="button"
                data-quote-filter="all"
                aria-pressed="true"
                class={chipClass}
              >
                All
              </button>
              {presentCategories.map((cat) => (
                <button
                  type="button"
                  data-quote-filter={cat}
                  aria-pressed="false"
                  class={chipClass}
                >
                  {categoryLabel(cat)}
                </button>
              ))}
            </div>
          </div>
        )}
        <div class="h-10" />
        <div class="line-t mb-46">
          <div class="row-grid">
            {quotes.map((quote) => (
              <figure
                data-quote-category={quoteCategories(quote.tags).join(" ")}
                class="flex flex-col px-4 py-6 sm:px-6 sm:py-8"
              >
                <blockquote class="text-base/7 whitespace-pre-line text-gray-950 dark:text-white">
                  {quote.text}
                </blockquote>
                <figcaption class="mt-4 text-sm/6">
                  <div class="font-semibold text-gray-950 dark:text-white">
                    {quote.author}
                  </div>
                  {quote.source && (
                    <div class="text-gray-600 dark:text-gray-400">
                      {quote.source}
                    </div>
                  )}
                </figcaption>
                {quote.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {quote.tags.map((tag) => (
                      <span
                        title={categoryLabel(tag.category)}
                        class="font-mono text-xs/5 text-gray-500 dark:text-gray-400"
                      >
                        #{tag.name}
                      </span>
                    ))}
                  </div>
                )}
              </figure>
            ))}
          </div>
        </div>
      </>
    ) : (
      <div class="line-y mb-46">
        <p class="container-main text-sm/7 text-gray-600 dark:text-gray-400">
          The first quotes are on the way. Meanwhile,{" "}
          <a
            href="/blog"
            class="font-semibold text-sky-500 hover:text-sky-600 dark:text-sky-400"
          >
            the blog has plenty to read
          </a>
          .
        </p>
      </div>
    )
  }
</PublicLayout>

<script>
  // Client-side category filter over server-rendered quotes: no refetch.
  // Without JS every quote stays visible and "All" stays pressed.
  const initQuoteFilter = () => {
    const chips = document.querySelectorAll<HTMLButtonElement>(
      "[data-quote-filter]",
    );
    const quotes = document.querySelectorAll<HTMLElement>(
      "[data-quote-category]",
    );
    if (!chips.length) return;
    const apply = (cat: string) => {
      chips.forEach((c) =>
        c.setAttribute("aria-pressed", String(c.dataset.quoteFilter === cat)),
      );
      quotes.forEach((q) => {
        const cats = (q.dataset.quoteCategory ?? "").split(" ").filter(Boolean);
        q.hidden = cat !== "all" && !cats.includes(cat);
      });
      // .row-grid hairlines use nth-child: keep visible cells first (original order).
      const all = [...quotes];
      quotes[0]?.parentElement?.append(
        ...all.filter((q) => !q.hidden),
        ...all.filter((q) => q.hidden),
      );
    };
    chips.forEach((c) =>
      c.addEventListener("click", () => apply(c.dataset.quoteFilter ?? "all")),
    );
  };

  initQuoteFilter();
  document.addEventListener("astro:page-load", initQuoteFilter);
</script>
